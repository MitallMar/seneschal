{
  "name": "seneschal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Сенешаль — прототип характеров и совета",
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc -p .",
    "lint": "eslint . --max-warnings 0 && node tools/long-lines.mjs",
    "test": "node --import tsx --test --test-reporter=spec \"test/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "e2e": "python3 test/e2e/smoke.py",
    "sim": "tsx tools/headless.ts",
    "axes": "tsx tools/axes.ts",
    "natura": "tsx tools/natura.ts",
    "health": "tsx tools/health.ts",
    "economy": "tsx tools/economy.ts",
    "bots": "tsx tools/bots.ts",
    "balance": "tsx tools/bots.ts --brief"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
